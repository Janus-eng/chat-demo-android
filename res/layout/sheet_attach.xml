<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="18dp">

    <HorizontalScrollView
        android:id="@+id/thumbs_scroll"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:visibility="gone"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/thumbs_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/tiles_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tile_camera"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tile"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_attach_camera" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="拍照"
                android:textSize="14sp"
                android:textColor="#1A1A1C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_gallery"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tile"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_attach_image" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="相册"
                android:textSize="14sp"
                android:textColor="#1A1A1C" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_files"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tile"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_attach_file" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="文件"
                android:textSize="14sp"
                android:textColor="#1A1A1C" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
